#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
WRAPPER="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER" ]; then
  echo "Missing $WRAPPER" >&2
  exit 1
fi
JAVA_EXE=${JAVA_HOME:+$JAVA_HOME/bin/java}
JAVA_EXE=${JAVA_EXE:-java}
exec "$JAVA_EXE" -Xmx64m -Xms64m -classpath "$WRAPPER" org.gradle.wrapper.GradleWrapperMain "$@"
