# Copy this file to android/keystore.properties on the machine that holds the
# upload keystore. keystore.properties is gitignored and must never be committed.
#
# Use forward slashes in storeFile, even on Windows.
# Do not put passwords in Git, chat, or source code.

storeFile=C:/Users/5520/gharrent-play-signing/gharrent-upload.p12
storePassword=YOUR_LOCAL_KEYSTORE_PASSWORD
keyAlias=gharrent-upload
keyPassword=YOUR_LOCAL_KEY_PASSWORD
